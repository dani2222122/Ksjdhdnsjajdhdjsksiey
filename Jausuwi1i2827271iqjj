def limpar_texto(texto):
    if not texto:
        return ""
    normalizado = unicodedata.normalize("NFKD", texto)
    sem_acento = "".join(c for c in normalizado if not unicodedata.combining(c))
    limpo = sem_acento.encode("ascii", "ignore").decode("ascii")
    return limpo.strip()


def gerar_coracao(tamanho=200):
    img = Image.new("1", (tamanho, tamanho), 1)
    draw = ImageDraw.Draw(img)
    pontos = []
    for t in range(0, 628):
        t_rad = t / 100
        x = 16 * (math.sin(t_rad) ** 3)
        y = 13 * math.cos(t_rad) - 5 * math.cos(2 * t_rad) - 2 * math.cos(3 * t_rad) - math.cos(4 * t_rad)
        px = tamanho / 2 + x * (tamanho / 40)
        py = tamanho / 2 - y * (tamanho / 40)
        pontos.append((px, py))
    draw.polygon(pontos, fill=0)
    return img


CORACAO_IMG = gerar_coracao()


def conectar_impressora():
    backend = usb.backend.libusb1.get_backend(
        find_library=lambda x: DLL_PATH
    )
    if backend is None:
        raise RuntimeError("Nao foi possivel carregar o backend libusb em: " + DLL_PATH)

    p = Usb(
        VENDOR_ID,
        PRODUCT_ID,
        in_ep=IN_EP,
        out_ep=OUT_EP,
        usb_args={"backend": backend},
    )
    try:
        p._raw(b"\x1B\x37\x07\xFF\x02")
    except Exception:
        pass
    return p


printer = None
try:
    printer = conectar_impressora()
    print("Impressora conectada com sucesso!")
except Exception as e:
    print("Erro ao conectar na impressora no inicio: " + str(e))


FILA_IMPRESSAO = queue.Queue()


NOME_GRANDE_ON = b"\x1D\x21\x11" + b"\x1B\x45\x01"
NOME_GRANDE_OFF = b"\x1D\x21\x00" + b"\x1B\x45\x00"


def _imprimir_agora(nome, tipo, extra="", desenhar_coracao=False):
    global printer

    if printer is None:
        try:
            printer = conectar_impressora()
        except Exception as e:
            print("Impressora indisponivel: " + str(e))
            return

    nome = limpar_texto(nome) or "Anonimo"
    extra = limpar_texto(extra)

    try:
        printer.set(align='center')
        printer._raw(NOME_GRANDE_ON)
        printer.text(nome + "\n")
        printer._raw(NOME_GRANDE_OFF)

        printer.set(align='center', bold=True, density=DENSIDADE_IMPRESSAO)
        if tipo == "comentario":
            printer.text(extra + "\n")
        else:
            printer.text(tipo + "\n")

        if desenhar_coracao:
            try:
                printer.image(CORACAO_IMG, center=True)
            except Exception as e:
                print("Erro ao imprimir coracao: " + str(e))

        printer.text("------------------------\n")
        printer._raw(CORTE_SEM_FEED)

    except DeviceNotFoundError as e:
        print("Impressora desconectada: " + str(e))
        printer = None
    except Exception as e:
        print("Erro ao imprimir: " + repr(e))


def _worker_impressao():
    while True:
        item = FILA_IMPRESSAO.get()
        if item is None:
            break
        nome, tipo, extra, desenhar_coracao = item
        _imprimir_agora(nome, tipo, extra=extra, desenhar_coracao=desenhar_coracao)
        FILA_IMPRESSAO.task_done()


threading.Thread(target=_worker_impressao, daemon=True).start()


def imprimir(nome, tipo, extra="", desenhar_coracao=False):
    FILA_IMPRESSAO.put((nome, tipo, extra, desenhar_coracao))


client = TikTokLiveClient(
    unique_id=TIKTOK_USERNAME,
    web_kwargs={
        "signer_kwargs": {"sign_api_key": EULER_API_KEY}
    },
)


@client.on(ConnectEvent)
async def on_connect(event):
    print("Conectado na live de @" + event.unique_id)

    try:
        info = getattr(client, "gift_info", None) or getattr(client, "available_gifts", None)
        if info:
            with open("presentes_encontrados.txt", "w", encoding="utf-8") as f:
                for gift_id, gift in info.items():
                    nome_presente = getattr(gift, "name", str(gift))
                    f.write(str(gift_id) + " -> " + str(nome_presente) + "\n")
            print("Lista de presentes salva em presentes_encontrados.txt")
    except Exception as e:
        print("Nao foi possivel salvar lista de presentes: " + str(e))


@client.on(CommentEvent)
async def on_comment(event):
    nome = event.user.nickname
    comentario = event.comment
    print(nome + " comentou: " + comentario)


def resolver_presente(gift_name):
    for chave, (texto, com_coracao) in PRESENTES.items():
        if chave in gift_name:
            return texto, com_coracao
    return "enviou " + limpar_texto(gift_name), False


@client.on(GiftEvent)
async def on_gift(event):
    nome = event.user.nickname
    gift = event.gift
    gift_name = gift.name.lower()

    is_streakable = getattr(gift, "type", 0) == 1

    if is_streakable and getattr(event, "streaking", False):
        return

    quantidade = event.repeat_count if is_streakable else 1
    quantidade = max(1, int(quantidade))

    print(nome + " enviou presente: " + gift_name + " x" + str(quantidade))

    texto_exibido, desenhar = resolver_presente(gift_name)

    for _ in range(quantidade):
        imprimir(nome, texto_exibido, desenhar_coracao=desenhar)


@client.on(FollowEvent)
async def on_follow(event):
    nome = event.user.nickname
    print(nome + " comecou a seguir")
    imprimir(nome, "comecou a seguir", desenhar_coracao=False)


def rodar_com_retry():
    tentativa = 0
    while MAX_TENTATIVAS_LIVE is None or tentativa < MAX_TENTATIVAS_LIVE:
        tentativa += 1
        try:
            print("Tentativa " + str(tentativa) + ": conectando na live de @" + TIKTOK_USERNAME + "...")
            client.run(fetch_gift_info=True)
            print("Conexao encerrada. Tentando reconectar...")
        except SignAPIError as e:
            print("Erro na Sign API (tentativa " + str(tentativa) + "): " + str(e))
        except KeyboardInterrupt:
            print("Encerrado pelo usuario.")
            break
        except Exception as e:
            print("Erro inesperado (tentativa " + str(tentativa) + "): " + str(e))

        time.sleep(ESPERA_ENTRE_TENTATIVAS)


if __name__ == '__main__':
    print("Iniciando conexao com a live...")
    rodar_com_retry()
